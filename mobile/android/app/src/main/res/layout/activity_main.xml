<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/omni_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="16dp"
    android:paddingBottom="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:contentDescription="Omni AGI"
            android:src="@drawable/ic_omni" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Omni AGI"
                android:textColor="@color/omni_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/identityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Same persistent brain · companion disconnected"
                android:textColor="@color/omni_muted"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/connectionBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/button_secondary"
            android:paddingStart="9dp"
            android:paddingTop="5dp"
            android:paddingEnd="9dp"
            android:paddingBottom="5dp"
            android:text="OFFLINE"
            android:textColor="@color/omni_muted"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/pairPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/panel_background"
            android:orientation="vertical"
            android:padding="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Open your brain on this phone"
            android:textColor="@color/omni_text"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="5dp"
            android:layout_marginBottom="16dp"
            android:text="In Studio, open Device &amp; runtime → Phone companion. Enter one address and the one-time code below. No weights or credentials are copied to Android."
            android:textColor="@color/omni_muted"
            android:textSize="12sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="5dp"
            android:text="COMPANION ADDRESS"
            android:textColor="@color/omni_muted"
            android:textSize="9sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/endpointInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints=""
            android:background="@drawable/field_background"
            android:hint="http://10.0.2.2:PORT"
            android:importantForAutofill="no"
            android:inputType="textUri"
            android:maxLines="1"
            android:textColor="@color/omni_text"
            android:textColorHint="@color/omni_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="13dp"
            android:layout_marginBottom="5dp"
            android:text="ONE-TIME CODE"
            android:textColor="@color/omni_muted"
            android:textSize="9sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/codeInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="oneTimeCode"
            android:background="@drawable/field_background"
            android:gravity="center"
            android:hint="000000"
            android:inputType="number"
            android:letterSpacing="0.18"
            android:maxLength="6"
            android:maxLines="1"
            android:textColor="@color/omni_text"
            android:textColorHint="@color/omni_muted"
            android:textSize="22sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/pairButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/button_primary"
            android:text="Pair with Studio"
            android:textAllCaps="false"
            android:textColor="@color/omni_on_accent"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/pairProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:layout_marginTop="10dp"
            android:indeterminate="true"
            android:indeterminateTint="@color/omni_accent"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pairStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textColor="@color/omni_muted"
            android:textSize="11sp" />
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/chatPanel"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="9dp">

            <Spinner
                android:id="@+id/brainSpinner"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/field_background"
                android:contentDescription="Choose brain instance"
                android:popupBackground="@color/omni_surface" />

            <Button
                android:id="@+id/disconnectButton"
                android:layout_width="wrap_content"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/button_secondary"
                android:minWidth="0dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="Disconnect"
                android:textAllCaps="false"
                android:textColor="@color/omni_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/messageScroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:fillViewport="true"
            android:overScrollMode="ifContentScrolls"
            android:paddingTop="5dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:id="@+id/messageList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <TextView
            android:id="@+id/liveStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:minHeight="24dp"
            android:text="Ready"
            android:textColor="@color/omni_muted"
            android:textSize="10sp" />

        <ProgressBar
            android:id="@+id/learnProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:max="100"
            android:progressTint="@color/omni_accent"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="bottom"
            android:orientation="horizontal"
            android:paddingTop="6dp">

            <Button
                android:id="@+id/attachButton"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/button_secondary"
                android:contentDescription="Learn a file, image, audio, or video"
                android:minWidth="0dp"
                android:padding="0dp"
                android:text="+"
                android:textAllCaps="false"
                android:textColor="@color/omni_accent"
                android:textSize="22sp" />

            <EditText
                android:id="@+id/messageInput"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="7dp"
                android:layout_weight="1"
                android:background="@drawable/field_background"
                android:gravity="top|start"
                android:hint="Message this brain…"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="5"
                android:minHeight="44dp"
                android:textColor="@color/omni_text"
                android:textColorHint="@color/omni_muted"
                android:textSize="13sp" />

            <Button
                android:id="@+id/sendButton"
                android:layout_width="60dp"
                android:layout_height="44dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/button_primary"
                android:minWidth="0dp"
                android:text="Send"
                android:textAllCaps="false"
                android:textColor="@color/omni_on_accent"
                android:textSize="12sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/stopButton"
                android:layout_width="50dp"
                android:layout_height="44dp"
                android:layout_marginStart="7dp"
                android:background="@drawable/button_secondary"
                android:contentDescription="Stop current turn"
                android:enabled="false"
                android:minWidth="0dp"
                android:text="Stop"
                android:textAllCaps="false"
                android:textColor="@color/omni_muted"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

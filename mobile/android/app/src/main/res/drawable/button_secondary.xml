<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/omni_accent_soft" />
            <stroke android:width="1dp" android:color="@color/omni_accent" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/omni_surface_raised" />
            <stroke android:width="1dp" android:color="@color/omni_border" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>

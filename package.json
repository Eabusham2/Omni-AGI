{
  "name": "omni-agi-studio",
  "version": "1.0.0",
  "description": "A cross-platform studio for building persistent, adaptive OmniCortex research models.",
  "main": "out/main/index.js",
  "author": "Omni-AGI contributors",
  "homepage": "https://github.com/Eabusham2/Omni-AGI",
  "license": "SEE LICENSE IN LICENSE.md",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run test:node && npm run test:python",
    "test:node": "vitest run",
    "test:python": "node scripts/run-python-tests.mjs",
    "test:python:portable": "python -m unittest discover -s engine/tests -p \"test_*.py\" -v",
    "test:ui": "npm run build && npm run test:ui:built",
    "test:ui:built": "playwright test --config playwright.config.ts",
    "test:watch": "vitest",
    "build:engine:win": "powershell -ExecutionPolicy Bypass -File scripts/build-engine.ps1",
    "build:engine:mac": "bash scripts/build-engine-posix.sh mac",
    "build:engine:linux": "bash scripts/build-engine-posix.sh linux",
    "package:win": "powershell -ExecutionPolicy Bypass -File scripts/package-windows.ps1 -Arch x64",
    "package:win:arm64": "powershell -ExecutionPolicy Bypass -File scripts/package-windows.ps1 -Arch arm64",
    "package:mac:x64": "bash scripts/package-posix.sh mac x64",
    "package:mac:arm64": "bash scripts/package-posix.sh mac arm64",
    "package:linux:x64": "bash scripts/package-posix.sh linux x64",
    "package:linux:arm64": "bash scripts/package-posix.sh linux arm64",
    "verify:release": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@playwright/test": "^1.61.1",
    "@types/node": "^24.1.0",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^4.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.0.6",
    "vitest": "^3.2.4"
  },
  "build": {
    "appId": "ai.omniagi.studio",
    "productName": "Omni AGI Studio",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json",
      "LICENSE.md",
      "COMMERCIAL_LICENSE.md",
      "THIRD_PARTY_NOTICES.md"
    ],
    "extraResources": [
      {
        "from": "engine",
        "to": "engine",
        "filter": [
          "**/*",
          "!tests{,/**/*}",
          "!**/__pycache__{,/**/*}"
        ]
      },
      {
        "from": "catalog",
        "to": "catalog"
      },
      {
        "from": "tools",
        "to": "tools"
      },
      {
        "from": "engine-dist/omni-engine",
        "to": "engine-runtime"
      },
      {
        "from": "licenses/BitNet-MIT.txt",
        "to": "licenses/BitNet-MIT.txt"
      },
      {
        "from": "licenses/snnTorch-MIT.txt",
        "to": "licenses/snnTorch-MIT.txt"
      },
      {
        "from": "licenses/NCPS-Apache-2.0.txt",
        "to": "licenses/NCPS-Apache-2.0.txt"
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "licenses/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "licenses/imageio-ffmpeg-BSD-2-Clause.txt",
        "to": "licenses/imageio-ffmpeg-BSD-2-Clause.txt"
      },
      {
        "from": "licenses/GPL-2.0.txt",
        "to": "licenses/GPL-2.0.txt"
      }
    ],
    "win": {
      "icon": "build/icon.svg",
      "target": [
        "nsis",
        "zip"
      ],
      "artifactName": "${productName}-${version}-Windows-${arch}.${ext}"
    },
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ],
      "artifactName": "${productName}-${version}-macOS-${arch}.${ext}",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "notarize": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist"
    },
    "dmg": {
      "sign": false
    },
    "linux": {
      "category": "Science",
      "target": [
        "AppImage",
        "deb",
        "tar.gz"
      ],
      "artifactName": "${productName}-${version}-Linux-${arch}.${ext}",
      "executableName": "omni-agi-studio",
      "synopsis": "Persistent adaptive OmniCortex research studio",
      "maintainer": "Omni-AGI contributors",
      "vendor": "Omni-AGI contributors"
    },
    "fileAssociations": [
      {
        "ext": "omni",
        "name": "Omni brain bundle",
        "description": "Portable OmniCortex brain bundle",
        "role": "Editor"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "useZip": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Omni AGI Studio"
    }
  }
}

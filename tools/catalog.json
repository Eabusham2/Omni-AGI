{
  "schemaVersion": 1,
  "tools": [
    {
      "id": "system.files",
      "label": "System files",
      "description": "List, read, and write absolute paths. Auto reads are contained to the brain-local directory; paths outside it and all writes require one-action approval unless Full Authority is enabled.",
      "defaultGrant": "ask",
      "actions": {
        "list": {
          "input": { "path": "string", "cursor": "string?", "pageSize": "number?" },
          "output": { "entries": "array", "total": "number", "hasMore": "boolean", "nextCursor": "string?" }
        },
        "read": {
          "input": { "path": "string", "maxBytes": "number?" },
          "output": { "content": "string", "sha256": "string" }
        },
        "write": {
          "input": { "path": "string", "content": "string", "expectedSha256": "string?" },
          "output": { "sha256": "string", "bytes": "number" }
        }
      }
    },
    {
      "id": "system.shell",
      "label": "System shell",
      "description": "Run an explicitly quoted command in the host's native noninteractive shell with an explicit working directory and timeout.",
      "defaultGrant": "ask",
      "actions": {
        "run": {
          "input": { "command": "string", "cwd": "string", "timeoutMs": "number?" },
          "output": { "exitCode": "number", "stdout": "string", "stderr": "string" }
        }
      }
    },
    {
      "id": "code.execute",
      "label": "Code runner",
      "description": "Run a saved program using a configured local toolchain.",
      "defaultGrant": "ask",
      "actions": {
        "run": {
          "input": {
            "language": "string",
            "entryPath": "string",
            "arguments": "string[]?",
            "timeoutMs": "number?"
          },
          "output": { "exitCode": "number", "stdout": "string", "stderr": "string" }
        }
      }
    },
    {
      "id": "web.search",
      "label": "Web search",
      "description": "Search through a configured SearxNG-compatible endpoint.",
      "defaultGrant": "ask",
      "actions": {
        "search": {
          "input": { "query": "string", "limit": "number?" },
          "output": { "results": "array" }
        }
      }
    },
    {
      "id": "web.fetch",
      "label": "Web fetch",
      "description": "Fetch a public HTTPS resource with bounded bytes and redirects.",
      "defaultGrant": "ask",
      "actions": {
        "fetch": {
          "input": { "url": "string", "maxBytes": "number?" },
          "output": { "status": "number", "contentType": "string", "content": "string" }
        }
      }
    },
    {
      "id": "browser.automation",
      "label": "Browser automation",
      "description": "Operate public pages through a persistent per-brain browser session with validated navigation, clicking, typing, key presses, waits, extraction, screenshots, and visible audit events.",
      "defaultGrant": "off",
      "actions": {
        "task": {
          "input": { "url": "string", "steps": "BrowserStep[]?", "visible": "boolean?", "timeoutMs": "number?" },
          "output": { "finalUrl": "string", "title": "string", "text": "string", "links": "array", "steps": "array", "artifactPath": "string?", "sessionPersistent": "boolean" }
        }
      }
    },
    {
      "id": "device.input",
      "label": "Device interaction",
      "description": "Move the pointer, click, scroll, press keys, or type through the current interactive desktop. Every action uses the per-brain permission policy, remains visible in the trace, is cancellable, and depends on host OS consent.",
      "defaultGrant": "ask",
      "actions": {
        "move-pointer": {
          "input": { "x": "number", "y": "number", "timeoutMs": "number?" },
          "output": { "state": "complete", "audit": "object" }
        },
        "click": {
          "input": { "button": "left|middle|right?", "timeoutMs": "number?" },
          "output": { "state": "complete", "audit": "object" }
        },
        "scroll": {
          "input": { "deltaX": "number?", "deltaY": "number?", "timeoutMs": "number?" },
          "output": { "state": "complete", "audit": "object" }
        },
        "key-press": {
          "input": { "key": "string", "modifiers": "ctrl|alt|shift|meta[]?", "timeoutMs": "number?" },
          "output": { "state": "complete", "audit": "object" }
        },
        "text": {
          "input": { "text": "string", "timeoutMs": "number?" },
          "output": { "state": "complete", "audit": "object" }
        }
      }
    },
    {
      "id": "modality.imagine",
      "label": "Imagination",
      "description": "Generate image, audio, or video from the current internal idea vector.",
      "defaultGrant": "auto",
      "actions": {
        "generate": {
          "input": {
            "modality": "image|audio|video",
            "conceptIds": "string[]?",
            "settings": "object?",
            "timeoutMs": "number?"
          },
          "output": {
            "jobId": "string",
            "state": "complete",
            "artifactPath": "string",
            "mimeType": "string",
            "seed": "number"
          }
        }
      }
    },
    {
      "id": "studio.ui",
      "label": "Creativity workspace",
      "description": "Open the local, reversible imagination and creativity workspace without granting filesystem, process, network, or source authority.",
      "defaultGrant": "auto",
      "actions": {
        "open-creativity": {
          "input": {},
          "output": {
            "workspace": "creativity",
            "view": "imagine",
            "local": "boolean",
            "reversible": "boolean"
          }
        }
      }
    },
    {
      "id": "studio.settings",
      "label": "Studio access settings",
      "description": "Inspect the current tool permission matrix or open its local settings view. This capability never changes a grant by itself.",
      "defaultGrant": "auto",
      "actions": {
        "inspect-access": {
          "input": {},
          "output": {
            "permissions": "array",
            "approvalTimeoutSeconds": "number",
            "grantsChanged": "false"
          }
        },
        "open-permissions": {
          "input": {},
          "output": {
            "workspace": "tools",
            "view": "permissions",
            "grantsChanged": "false"
          }
        }
      }
    },
    {
      "id": "brain.history",
      "label": "Conversation history",
      "description": "Read or search this brain's own visible conversation and audited action summaries. It never returns private activations, hidden reasoning, or another brain's history.",
      "defaultGrant": "auto",
      "actions": {
        "read": {
          "input": { "cursor": "string?", "limit": "number?", "includeActions": "boolean?" },
          "output": { "entries": "array", "nextCursor": "string?", "privateReasoningIncluded": "false" }
        },
        "search": {
          "input": { "query": "string", "cursor": "string?", "limit": "number?", "includeActions": "boolean?" },
          "output": { "entries": "array", "nextCursor": "string?", "privateReasoningIncluded": "false" }
        }
      }
    },
    {
      "id": "agent.fork",
      "label": "Subagent fork",
      "description": "Create up to four isolated cognitive branches, run the objective once in each copied neural state, and return inspectable merge candidates.",
      "defaultGrant": "ask",
      "actions": {
        "start": {
          "input": { "objective": "string", "workers": "number?", "budget": "number?" },
          "output": { "jobId": "string", "forkIds": "string[]" }
        }
      }
    },
    {
      "id": "source.self-modify",
      "label": "Source evolution",
      "description": "Fork the source workspace, edit it, run required checks, and produce a promotion candidate.",
      "defaultGrant": "off",
      "actions": {
        "propose": {
          "input": { "objective": "string", "candidateKind": "string?", "addExperts": "number?", "tests": "string[]?" },
          "output": { "worktree": "string", "diff": "string", "checks": "array" }
        },
        "diff": {
          "input": { "worktree": "string" },
          "output": { "status": "string", "diff": "string", "sha256": "string" }
        },
        "test": {
          "input": { "worktree": "string", "tests": "typecheck|unit|build[]?", "timeoutMs": "number?" },
          "output": { "passed": "boolean", "diffSha256": "string", "checks": "array" }
        },
        "promote": {
          "input": { "worktree": "string", "expectedDiffSha256": "string" },
          "output": {
            "promoted": "boolean",
            "commit": "string",
            "candidateCommit": "string",
            "parentCommit": "string",
            "diffSha256": "string"
          }
        },
        "rollback": {
          "input": { "expectedCommit": "string", "parentCommit": "string" },
          "output": { "rolledBack": "boolean", "rollbackCommit": "string" }
        }
      }
    }
  ]
}
